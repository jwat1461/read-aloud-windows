# Normalise to LF in the repository, check out native on each platform.
* text=auto

# Windows scripts must keep CRLF or cmd.exe mis-parses them.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.py  text eol=lf
*.js  text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md  text eol=lf

*.png binary
*.ico binary
*.wav binary
